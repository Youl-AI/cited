# --- 필수 (1단계) ---
DATABASE_URL=                 # Neon 대시보드 > Connection string (pooled)
DATABASE_URL_UNPOOLED=        # Neon 대시보드 > Connection string (direct) — 마이그레이션용
BETTER_AUTH_SECRET=           # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=               # resend.com > API Keys
EMAIL_FROM=Cited <noreply@example.com>

# --- 크론 (1단계) ---
# vercel.json에 등록된 스케줄(만료 세션 일괄 삭제)이 /api/cron/* 을 호출할 때
# 쓰는 인증 값. Vercel은 이 변수가 설정돼 있으면 크론 호출에
# `Authorization: Bearer $CRON_SECRET` 헤더를 자동으로 붙이고, 라우트가 그
# 헤더를 검증한다. 라우트 URL은 공개되므로 이게 유일한 방어선이다.
#
# 로컬 개발에서는 비워 둬도 된다(크론이 돌지 않는다). 배포에서는 필수이며,
# 비어 있으면 부팅 단계에서 검증 실패한다 — 없으면 만료 세션 정리가 조용히
# 멈추고 개인정보처리방침 §3·§4가 거짓이 되기 때문이다.
# 값 생성: openssl rand -base64 32 (여기 적지 말고 Vercel 환경변수에 넣는다)
CRON_SECRET=

# 무료 진단 신청 알림을 받을 주소.
#
# 무료 진단은 운영자가 CLI로 직접 실행한다. 이 알림이 유일한 실행 트리거이므로,
# 비어 있으면 인증까지 끝난 신청이 방치되고 고객에게 약속한 "영업일 1일 이내
# 발송"이 조용히 깨진다. 로컬 개발에서는 비워 둬도 되고, 배포에서는 필수다.
#
# ★ 배포에 넣는 값은 contact@cited.co.kr 이다 (2026-07-30 결정).
#   조건은 하나뿐이다 — **운영자가 실제로 매일 여는 메일함**이어야 한다.
#   형식 검증은 env.ts가 하지만 "그 주소가 진짜 도착하는가"는 검증할 수 없다.
#
#   cited.co.kr의 수신과 발송은 서로 다른 곳에 설정돼 있다. 헷갈리면
#   "Resend에 도메인을 인증했으니 받을 수도 있겠지"라고 착각하게 된다:
#     수신  cited.co.kr        MX → Zoho Mail
#     발송  send.cited.co.kr   SPF → amazonses.com (Resend 백엔드)
#     서명  resend._domainkey.cited.co.kr (루트에 있어 DMARC 정렬이 맞는다)
#   Resend 도메인 인증은 **발송 권한**이고 메일함을 만들어주지 않는다.
#   주소를 바꿀 때는 그 주소로 실제 한 통을 보내 도착까지 확인할 것.
OPERATOR_EMAIL=

# --- 선택 (1단계) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- 선택: pnpm usage (비용 리포트) ---
# admin 키는 조직 관리 권한이 딸려 있다 — 이 스크립트 용도 외에는 쓰지 말 것.
# OpenAI 쪽은 발급 시 권한을 Usage 읽기 전용으로 제한해서 만든다.
# Gemini는 비용 조회 API가 없다 (scripts/usage-report.mts 상단 주석 참고).
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=

# --- 2단계 이후에 채운다 ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
TRIGGER_SECRET_KEY=
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
