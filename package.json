{
  "name": "cited",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "probe:engine": "tsx --conditions=react-server --env-file=.env.local scripts/probe-engine.mts",
    "probe:collection": "tsx --conditions=react-server --env-file=.env.local scripts/probe-collection.mts",
    "probe:audit": "tsx --conditions=react-server --env-file=.env.local scripts/probe-audit.mts",
    "probe:aliases": "tsx --conditions=react-server --env-file=.env.local scripts/probe-aliases.mts",
    "audit:list": "tsx --conditions=react-server --env-file=.env.local scripts/audit-list.mts",
    "audit:new": "tsx --conditions=react-server --env-file=.env.local scripts/audit-new.mts",
    "audit:run": "tsx --conditions=react-server --env-file=.env.local scripts/audit-run.mts",
    "audit:reject": "tsx --conditions=react-server --env-file=.env.local scripts/audit-reject.mts",
    "audit:resend": "tsx --conditions=react-server --env-file=.env.local scripts/audit-resend.mts",
    "measure": "tsx --conditions=react-server --env-file=.env.local scripts/measure.mts",
    "label:collect": "tsx --conditions=react-server --env-file=.env.local scripts/label-collect.mts",
    "label": "tsx --conditions=react-server scripts/label.mts",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "usage": "tsx --env-file=.env.local scripts/usage-report.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@google/genai": "2.13.0",
    "@neondatabase/serverless": "1.1.0",
    "@sentry/nextjs": "10.68.0",
    "better-auth": "1.6.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "openai": "7.1.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
